# OSINT Chile Graph - configuración local
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=osint_chile
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint_dev_password
DATABASE_URL=postgresql+psycopg://osint:osint_dev_password@postgres:5432/osint_chile

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=osint_neo4j_password

REDIS_URL=redis://redis:6379/0

# Ollama corre por defecto en la máquina local del usuario, fuera de Docker Compose.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# API externa compatible con OpenAI. No agregar claves reales al repositorio.
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=

VITE_API_URL=http://localhost:8000
